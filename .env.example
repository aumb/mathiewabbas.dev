NEXT_PUBLIC_POCKETBASE_URL=

# PostHog Analytics (US region)
# Project API key from PostHog > Project Settings (starts with phc_).
# Traffic is reverse-proxied through /mp (see next.config.mjs) to dodge ad blockers.
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only PocketBase account for view counts, so visitors never write to
# PocketBase directly. Create it as a record in the users collection.
POCKETBASE_SERVICE_EMAIL=
POCKETBASE_SERVICE_PASSWORD=
